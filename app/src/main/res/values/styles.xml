<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal usando Material Components -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/corTitulo</item>

        <!-- Para compatibilidade com Material Components -->
        <item name="materialButtonStyle">@style/Widget.Condominio.Button</item>
        <item name="textInputStyle">@style/Widget.Condominio.TextInputLayout</item>
    </style>

    <!-- Estilo customizado para TextInputLayout -->
    <style name="Widget.Condominio.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/colorPrimary</item>
    </style>

    <!-- Botão padrão do app: azul, cantos bem arredondados, texto sem caixa-alta -->
    <style name="Widget.Condominio.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/botaoPrimario</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:elevation">2dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- Cartão do painel: ícone grande em cima, texto embaixo, cor definida em cada botão -->
    <style name="Widget.Condominio.Painel" parent="Widget.Condominio.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">118dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">7dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">38dp</item>
        <item name="iconPadding">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="BotaoCameras">
        <item name="android:background">@color/purple_500</item>
        <item name="android:textColor">@color/black</item>
    </style>

</resources>