<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#F0F2F8">

    <ImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:src="@drawable/ic_boleto_vencido"
        android:contentDescription="App travado" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="App travado"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#B91C1C" />

    <TextView
        android:id="@+id/tvMensagemBloqueio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="A assinatura do aplicativo do condomínio não foi paga até o dia 05."
        android:textSize="16sp"
        android:textColor="#374151" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPagarAssinatura"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="26dp"
        android:text="Pagar assinatura"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="18dp"
        app:backgroundTint="@color/painelPagamentos" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTentarNovamente"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Já foi pago? Verificar de novo"
        android:textAllCaps="false"
        app:cornerRadius="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSairBloqueio"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sair da conta"
        android:textAllCaps="false" />
</LinearLayout>
