<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F2F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            android:text="Cadastro"
            android:textColor="#1A1A2E"
            android:textSize="24sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="13dp"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <Button
                android:id="@+id/buttonAdministradores"
                style="@style/Widget.Condominio.Painel"
                android:text="Administradores"
                app:backgroundTint="@color/painelAdministradores"
                app:icon="@drawable/ic_painel_administradores" />

            <Button
                android:id="@+id/buttonAssembleias"
                style="@style/Widget.Condominio.Painel"
                android:text="Assembleias"
                app:backgroundTint="@color/painelAssembleias"
                app:icon="@drawable/ic_painel_assembleias" />

            <Button
                android:id="@+id/buttonDespesas"
                style="@style/Widget.Condominio.Painel"
                android:text="Despesas"
                app:backgroundTint="@color/painelDespesas"
                app:icon="@drawable/ic_painel_despesas" />

            <Button
                android:id="@+id/buttonAvisos"
                style="@style/Widget.Condominio.Painel"
                android:text="Avisos"
                app:backgroundTint="@color/painelAvisos"
                app:icon="@drawable/ic_painel_avisos" />

            <Button
                android:id="@+id/buttonCadastroMoradores"
                style="@style/Widget.Condominio.Painel"
                android:text="Moradores"
                app:backgroundTint="@color/painelMoradores"
                app:icon="@drawable/ic_painel_moradores" />

            <Button
                android:id="@+id/buttonRegistroOcorrencias"
                style="@style/Widget.Condominio.Painel"
                android:text="Ocorrências"
                app:backgroundTint="@color/painelOcorrencias"
                app:icon="@drawable/ic_painel_ocorrencias" />

            <Button
                android:id="@+id/buttonManutencao"
                style="@style/Widget.Condominio.Painel"
                android:text="Manutenção"
                app:backgroundTint="@color/painelManutencao"
                app:icon="@drawable/ic_painel_manutencao" />

            <Button
                android:id="@+id/buttonFuncionarios"
                style="@style/Widget.Condominio.Painel"
                android:text="Funcionários"
                app:backgroundTint="@color/painelFuncionarios"
                app:icon="@drawable/ic_painel_funcionarios" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
