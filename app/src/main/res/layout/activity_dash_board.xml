<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F2F8">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        tools:context=".DashBoardActivity">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_cabecalho_painel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Administração"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Único jeito de sair: desloga e volta pro login -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSair"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Sair"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_sair"
                    app:iconSize="18dp"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nome_condominio"
                android:textColor="#DBEAFE"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Cartões (os que não são do perfil ficam GONE e a grade se reorganiza) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="13dp"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <!-- ========== ADMIN ========== -->
            <Button
                android:id="@+id/buttonAdministradores"
                style="@style/Widget.Condominio.Painel"
                android:text="Administradores"
                app:backgroundTint="@color/painelAdministradores"
                app:icon="@drawable/ic_painel_administradores" />

            <Button
                android:id="@+id/buttonAssembleias"
                style="@style/Widget.Condominio.Painel"
                android:text="Assembleias"
                app:backgroundTint="@color/painelAssembleias"
                app:icon="@drawable/ic_painel_assembleias" />

            <Button
                android:id="@+id/buttonDespesas"
                style="@style/Widget.Condominio.Painel"
                android:text="Despesas"
                app:backgroundTint="@color/painelDespesas"
                app:icon="@drawable/ic_painel_despesas" />

            <Button
                android:id="@+id/buttonAvisos"
                style="@style/Widget.Condominio.Painel"
                android:text="Avisos"
                app:backgroundTint="@color/painelAvisos"
                app:icon="@drawable/ic_painel_avisos" />

            <Button
                android:id="@+id/buttonCadastroMoradores"
                style="@style/Widget.Condominio.Painel"
                android:text="Moradores"
                app:backgroundTint="@color/painelMoradores"
                app:icon="@drawable/ic_painel_moradores" />

            <Button
                android:id="@+id/buttonRegistroOcorrencias"
                style="@style/Widget.Condominio.Painel"
                android:text="Ocorrências"
                app:backgroundTint="@color/painelOcorrencias"
                app:icon="@drawable/ic_painel_ocorrencias" />

            <Button
                android:id="@+id/buttonManutencao"
                style="@style/Widget.Condominio.Painel"
                android:text="Manutenção"
                app:backgroundTint="@color/painelManutencao"
                app:icon="@drawable/ic_painel_manutencao" />

            <Button
                android:id="@+id/buttonFuncionarios"
                style="@style/Widget.Condominio.Painel"
                android:text="Funcionários"
                app:backgroundTint="@color/painelFuncionarios"
                app:icon="@drawable/ic_painel_funcionarios" />

            <Button
                android:id="@+id/buttonLeiturasAgua"
                style="@style/Widget.Condominio.Painel"
                android:text="Leitura d'Água"
                app:backgroundTint="@color/painelAgua"
                app:icon="@drawable/ic_painel_agua" />

            <!-- ========== MORADOR ========== -->
            <Button
                android:id="@+id/buttonListaDespesas"
                style="@style/Widget.Condominio.Painel"
                android:text="Prestação de Contas"
                app:backgroundTint="@color/painelDespesas"
                app:icon="@drawable/ic_painel_contas" />

            <Button
                android:id="@+id/buttonAvisosMorador"
                style="@style/Widget.Condominio.Painel"
                android:text="Avisos"
                app:backgroundTint="@color/painelAvisos"
                app:icon="@drawable/ic_painel_avisos" />

            <Button
                android:id="@+id/buttonLeituraAgua"
                style="@style/Widget.Condominio.Painel"
                android:text="Leitura d'Água"
                app:backgroundTint="@color/painelAgua"
                app:icon="@drawable/ic_painel_agua" />

            <!-- ========== LISTAS (admin e morador): linha inteira ========== -->
            <Button
                android:id="@+id/buttonListas"
                style="@style/Widget.Condominio.Painel"
                android:layout_height="84dp"
                android:layout_columnSpan="2"
                android:text="Listas"
                app:backgroundTint="@color/painelListas"
                app:icon="@drawable/ic_painel_listas"
                app:iconGravity="textStart"
                app:iconSize="28dp" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
