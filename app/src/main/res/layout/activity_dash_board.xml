<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F2F8">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp"
        tools:context=".DashBoardActivity">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_cabecalho_painel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp">

            <!-- Admin: nome de quem está logado, acima do título -->
            <TextView
                android:id="@+id/textAdminLogado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textColor="#000000"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Administração"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Único jeito de sair: desloga e volta pro login -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSair"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Sair"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_sair"
                    app:iconSize="18dp"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nome_condominio"
                android:textColor="#DBEAFE"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Cartões (os que não são do perfil ficam GONE e a grade se reorganiza) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="13dp"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <!-- ========== ADMIN ========== -->
            <Button
                android:id="@+id/buttonCadastro"
                style="@style/Widget.Condominio.Painel"
                android:text="Cadastro"
                app:backgroundTint="@color/painelAdministradores"
                app:icon="@drawable/ic_painel_cadastro" />

            <!-- Lista por quadra/lote com os boletos em PDF -->
            <Button
                android:id="@+id/buttonBoletosMorador"
                style="@style/Widget.Condominio.Painel"
                android:text="Boletos Morador"
                app:backgroundTint="@color/painelPagamentos"
                app:icon="@drawable/ic_painel_pagamentos" />

            <Button
                android:id="@+id/buttonLeiturasAgua"
                style="@style/Widget.Condominio.Painel"
                android:text="Leitura d'Água"
                app:backgroundTint="@color/painelAgua"
                app:icon="@drawable/ic_painel_agua" />

            <!-- ========== MORADOR ========== -->
            <Button
                android:id="@+id/buttonListaDespesas"
                style="@style/Widget.Condominio.Painel"
                android:text="Prestação de Contas"
                app:backgroundTint="@color/painelDespesas"
                app:icon="@drawable/ic_painel_contas" />

            <Button
                android:id="@+id/buttonAvisosMorador"
                style="@style/Widget.Condominio.Painel"
                android:text="Avisos"
                app:backgroundTint="@color/painelAvisos"
                app:icon="@drawable/ic_painel_avisos" />

            <Button
                android:id="@+id/buttonLeituraAgua"
                style="@style/Widget.Condominio.Painel"
                android:text="Leitura d'Água"
                app:backgroundTint="@color/painelAgua"
                app:icon="@drawable/ic_painel_agua" />

            <!-- Morador (não o master): boletos; fica embaixo de "Avisos" -->
            <Button
                android:id="@+id/buttonPagamentos"
                style="@style/Widget.Condominio.Painel"
                android:text="Pagamentos"
                app:backgroundTint="@color/painelPagamentos"
                app:icon="@drawable/ic_painel_pagamentos" />

            <!-- Só o master: assinatura do app -->
            <Button
                android:id="@+id/buttonAssinaturas"
                style="@style/Widget.Condominio.Painel"
                android:text="Assinaturas"
                app:backgroundTint="@color/painelAdministradores"
                app:icon="@drawable/ic_painel_assinaturas" />

            <!-- Morador: lista de assembleias (antes ficava em "Listas") -->
            <Button
                android:id="@+id/buttonAssembleiasMorador"
                style="@style/Widget.Condominio.Painel"
                android:text="Assembleias"
                app:backgroundTint="@color/painelAssembleias"
                app:icon="@drawable/ic_painel_assembleias" />

            <!-- ========== LISTAS (admin) ========== -->
            <Button
                android:id="@+id/buttonListas"
                style="@style/Widget.Condominio.Painel"
                android:text="Listas"
                app:backgroundTint="@color/painelListas"
                app:icon="@drawable/ic_painel_listas" />

            <!-- Admin: chat com os moradores, chat entre administradores e backup -->
            <Button
                android:id="@+id/buttonChatMoradores"
                style="@style/Widget.Condominio.Painel"
                android:text="Chat com Moradores"
                app:backgroundTint="@color/painelMoradores"
                app:icon="@drawable/ic_chat_branco" />

            <Button
                android:id="@+id/buttonChatAdmin"
                style="@style/Widget.Condominio.Painel"
                android:text="Chat admin"
                app:backgroundTint="@color/painelAdministradores"
                app:icon="@drawable/ic_chat_branco" />

            <Button
                android:id="@+id/buttonBackup"
                style="@style/Widget.Condominio.Painel"
                android:text="Backup"
                app:backgroundTint="@color/painelListas"
                app:icon="@drawable/ic_painel_backup" />

            <!-- Admin: os quadros que o morador vê ao entrar -->
            <Button
                android:id="@+id/buttonVerComoMorador"
                style="@style/Widget.Condominio.Painel"
                android:text="Ver como morador"
                app:backgroundTint="@color/painelMoradores"
                app:icon="@drawable/ic_painel_moradores" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
