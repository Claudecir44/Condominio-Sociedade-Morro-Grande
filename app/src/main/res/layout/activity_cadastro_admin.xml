<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textTituloCadastroAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Cadastro de administrador"
            android:textColor="#1A1A2E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textInfoCadastroAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="#4B5563"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editNomeAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do Administrador"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/editEmailAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="E-mail"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/editSenhaAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha (6 dígitos)"
            android:inputType="numberPassword"
            android:maxLength="6" />

        <EditText
            android:id="@+id/editTelefoneAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Telefone (opcional)"
            android:inputType="phone" />

        <Button
            android:id="@+id/btnCadastrarAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cadastrar Administrador" />
    </LinearLayout>
</ScrollView>
