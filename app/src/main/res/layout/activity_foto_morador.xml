<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Cadastre sua foto"
            android:textColor="#1A1A2E"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textOlaMorador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Antes de entrar, coloque uma foto sua. Ela ajuda a portaria e a administração a identificar os moradores."
            android:textColor="#4B5563"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/imageFotoMorador"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/image_border"
            android:contentDescription="Sua foto"
            android:padding="6dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera" />

        <Button
            android:id="@+id/btnTirarFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tirar foto"
            app:icon="@android:drawable/ic_menu_camera"
            app:iconGravity="textStart" />

        <Button
            android:id="@+id/btnGaleria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escolher da galeria"
            app:backgroundTint="@color/botaoSecundario"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart" />

        <Button
            android:id="@+id/btnSalvarFoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="Salvar foto e entrar"
            app:backgroundTint="@color/botaoSucesso" />
    </LinearLayout>
</ScrollView>
