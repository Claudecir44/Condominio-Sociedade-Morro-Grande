<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F8">

    <TextView
        android:id="@+id/textTituloConversas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chat com Moradores"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/textDicaConversas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="12dp"
        android:text="Os moradores veem estas conversas como &quot;Administração&quot;.\nToque e segure para apagar uma conversa."
        android:textSize="13sp"
        android:textColor="#6B7280" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNovaConversa"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:text="Nova conversa"
        android:textAllCaps="false"
        app:icon="@drawable/ic_chat_branco"
        app:iconGravity="textStart"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/botaoPrimario" />

    <TextView
        android:id="@+id/tvConversasVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Nenhuma conversa ainda."
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerConversas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp" />
</LinearLayout>
