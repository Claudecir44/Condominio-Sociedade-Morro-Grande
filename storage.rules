rules_version = '2';

// Anexos e fotos do app Condomínio Sociedade Morro Grande.
// Caminho: {modulo}/{idDoRegistro}/{arquivo}. Mesmas permissões do Firestore:
// avisos, assembleias e despesas os moradores podem ver; o resto é só do administrador.
service firebase.storage {
  match /b/{bucket}/o {

    function ehAdmin() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/administradores/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/administradores/$(request.auth.uid)).data.tipo == 'admin';
    }

    function ehMorador() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/moradores/$(request.auth.uid));
    }

    match /{modulo}/{id}/{arquivo} {
      allow read: if ehAdmin()
                  || (modulo in ['avisos', 'assembleias', 'despesas'] && ehMorador())
                  || (modulo in ['moradores', 'boletos'] && request.auth != null && request.auth.uid == id);
      allow create, update: if ehAdmin() && request.resource.size < 20 * 1024 * 1024;
      allow delete: if ehAdmin();
    }

    // Foto do próprio morador (primeiro login) e fotos do hidrômetro: o morador envia só na pasta dele.
    // Sem consulta ao Firestore aqui (ela dá 403 sem a permissão entre serviços); quem prende a
    // gravação ao cadastro de morador é a regra do Firestore (moradores/{uid} e leituras_agua).
    function fotoDoProprioMorador(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.resource.contentType.matches('image/.*')
          && request.resource.size < 10 * 1024 * 1024;
    }

    match /moradores/{uid}/{arquivo} {
      allow create, update: if fotoDoProprioMorador(uid);
    }

    // Boletos em PDF: além do admin (regra geral acima), a conta master do app Moradores também
    // posta. Confere pelo login da conta (sem consulta ao Firestore, que dá 403 aqui); quem prende
    // o boleto ao morador é a regra do Firestore (boletos/{id}).
    function ehContaMaster() {
      return request.auth != null
          && request.auth.token.email == 'condominiosociedademorrogrande@moradores.morrogrande.app';
    }

    match /boletos/{uid}/{arquivo} {
      // Leitura também é necessária pra pegar o link de download logo depois do envio
      allow read: if ehContaMaster();
      allow create: if ehContaMaster()
                    && request.resource.contentType == 'application/pdf'
                    && request.resource.size < 20 * 1024 * 1024;
    }

    match /leituras/{uid}/{arquivo} {
      allow read: if ehAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if fotoDoProprioMorador(uid);
    }

    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
