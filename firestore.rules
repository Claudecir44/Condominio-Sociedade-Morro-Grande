rules_version = '2';

// Regras do app Condomínio Sociedade Morro Grande.
// - Administrador: conta no Firebase Auth + documento administradores/{uid} com tipo == 'admin'.
// - Morador: conta no Firebase Auth (login quadra+lote) + documento moradores/{uid}.
// - Morador só lê; quem grava é o administrador.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function caminho(colecao, id) {
      return /databases/$(database)/documents/$(colecao)/$(id);
    }

    function ehAdmin() {
      return logado()
          && exists(caminho('administradores', request.auth.uid))
          && get(caminho('administradores', request.auth.uid)).data.tipo == 'admin';
    }

    function ehMorador() {
      return logado() && exists(caminho('moradores', request.auth.uid));
    }

    // Morador de visualização (conta que os admins usam pra ver as telas do morador):
    // vê a lista de todos os moradores. O campo verTodos só o admin grava.
    function moradorVeTodos() {
      return logado()
          && exists(caminho('moradores', request.auth.uid))
          && get(caminho('moradores', request.auth.uid)).data.get('verTodos', false) == true;
    }

    function membro() {
      return ehAdmin() || ehMorador();
    }

    // Marca que o primeiro administrador já foi criado. Leitura pública só pra tela de login
    // saber se mostra o cadastro do primeiro admin (não tem dado pessoal).
    match /config/setup {
      allow read: if true;
      allow create: if logado()
                    && !exists(caminho('config', 'setup'))
                    && request.resource.data.primeiroAdmin == request.auth.uid
                    && getAfter(caminho('administradores', request.auth.uid)).data.tipo == 'admin';
      allow update, delete: if false;
    }

    // Assinatura do app: todos os membros leem o último mês pago (pagoAteMes) pra saber se o
    // app trava; só a Cloud Function confirmarCompraAssinaturaCondominio grava (Admin SDK).
    match /config/assinatura {
      allow read: if membro();
      allow write: if false;
    }
    match /pagamentosAssinatura/{id} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    match /administradores/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      // Novo admin: criado por um admin, ou o primeiro admin (junto com config/setup, uma vez só)
      // O campo master (admin master) nunca é gravado pelo app, só pelo script de criação
      allow create: if request.resource.data.get('master', false) == false
                    && (ehAdmin()
                        || (logado()
                            && request.auth.uid == uid
                            && request.resource.data.tipo == 'admin'
                            && !exists(caminho('config', 'setup'))
                            && existsAfter(caminho('config', 'setup'))));
      // Ninguém liga/desliga o master, e o cadastro do master só ele mesmo altera
      allow update: if ehAdmin()
                    && request.resource.data.get('master', false) == resource.data.get('master', false)
                    && (resource.data.get('master', false) != true || request.auth.uid == uid);
      allow delete: if ehAdmin() && request.auth.uid != uid && resource.data.get('master', false) != true;
    }

    // Pedido do "Cadastre-se" do login admin: a própria conta cria o pedido pendente;
    // só admin lê a lista, aprova (cria administradores/{uid} e apaga o pedido) ou recusa.
    match /solicitacoes_admin/{uid} {
      allow read: if ehAdmin() || (logado() && request.auth.uid == uid);
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pendente'
                    && !exists(caminho('administradores', uid));
      allow update, delete: if ehAdmin();
    }

    match /moradores/{uid} {
      allow read: if ehAdmin() || (logado() && request.auth.uid == uid) || moradorVeTodos();
      allow write: if ehAdmin();
      // No primeiro login o próprio morador cadastra a foto (só esse campo)
      allow update: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foto'])
                    && request.resource.data.foto is string;
    }

    // Leitura d'água: o morador envia a dele (com a quadra/lote do próprio cadastro);
    // admin vê todas e pode excluir; a conta master só vê todas. Ninguém edita depois de enviada.
    match /leituras_agua/{id} {
      allow read: if ehAdmin() || moradorVeTodos() || (logado() && resource.data.moradorUid == request.auth.uid);
      allow create: if ehMorador()
                    && request.resource.data.keys().hasOnly(['moradorUid', 'nome', 'quadra', 'lote', 'leitura', 'foto', 'criadoEm'])
                    && request.resource.data.moradorUid == request.auth.uid
                    && request.resource.data.quadra == get(caminho('moradores', request.auth.uid)).data.quadra
                    && request.resource.data.lote == get(caminho('moradores', request.auth.uid)).data.lote
                    && request.resource.data.leitura is string
                    && request.resource.data.leitura.size() > 0
                    && request.resource.data.leitura.size() <= 12
                    && request.resource.data.foto is string
                    && request.resource.data.criadoEm == request.time;
      allow update: if false;
      allow delete: if ehAdmin();
    }

    // Boletos (PDF): o admin ou a conta master posta para um morador (data/hora do servidor), com
    // o mês de referência ("2026-11"), marca "não pago" e exclui. O morador vê só os dele.
    match /boletos/{id} {
      allow read: if ehAdmin() || moradorVeTodos()
                  || (logado() && resource.data.moradorUid == request.auth.uid);
      allow create: if (ehAdmin() || moradorVeTodos())
                    && request.resource.data.keys().hasOnly(['moradorUid', 'arquivo', 'nomeArquivo', 'postadoEm', 'naoPago', 'mes'])
                    && request.resource.data.get('mes', '2000-01').matches('[0-9]{4}-[0-9]{2}')
                    && request.resource.data.moradorUid is string
                    && request.resource.data.arquivo is string
                    && request.resource.data.postadoEm == request.time
                    && request.resource.data.naoPago == false;
      allow update: if (ehAdmin() || moradorVeTodos())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['naoPago'])
                    && request.resource.data.naoPago is bool;
      allow delete: if ehAdmin() || moradorVeTodos();
    }

    // Meses criados em "Boletos Morador", por morador: boletos_meses/{moradorUid}.meses. Valem
    // mesmo sem boleto, para o mês aparecer no app Admins e no painel web.
    match /boletos_meses/{moradorUid} {
      allow read: if ehAdmin();
      allow create, update: if ehAdmin()
                            && request.resource.data.keys().hasOnly(['meses'])
                            && request.resource.data.meses is list;
    }

    // Meses criados no mês a mês de cada cadastro: meses_cadastro/{colecao}.meses
    match /meses_cadastro/{colecao} {
      // Moradores leem para ver as listas mês a mês (Prestação de Contas); só o admin cria meses
      allow read: if membro();
      allow create, update: if ehAdmin()
                            && request.resource.data.keys().hasOnly(['meses'])
                            && request.resource.data.meses is list;
    }

    // Chat morador x Administração: uma conversa por morador (conversas/{moradorUid}); qualquer
    // admin, ou a conta master do app Moradores, responde como "Administração". O morador só mexe
    // na própria conversa.
    function ehAdministracao() {
      return ehAdmin() || moradorVeTodos();
    }
    function ehMoradorDono(moradorUid) {
      return logado() && request.auth.uid == moradorUid && ehMorador();
    }
    function soMudou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    match /conversas/{moradorUid} {
      allow read: if ehAdministracao() || (logado() && request.auth.uid == moradorUid);
      allow create, update: if (ehAdministracao() || ehMoradorDono(moradorUid))
                            && request.resource.data.moradorUid == moradorUid
                            && request.resource.data.keys().hasOnly(['moradorUid', 'ultimaMensagem', 'ultimoTimestamp',
                                                                     'ultimoDeAdmin', 'naoLidasMorador', 'naoLidasAdmin']);
      allow delete: if ehAdministracao();

      match /mensagens/{id} {
        allow read: if ehAdministracao() || (logado() && request.auth.uid == moradorUid);
        allow create: if request.resource.data.remetenteId == request.auth.uid
                      && request.resource.data.timestamp == request.time
                      && ((ehAdministracao() && request.resource.data.deAdmin == true)
                          || (ehMoradorDono(moradorUid) && request.resource.data.deAdmin == false));
        // Marcar como lida / apagar só pra mim; "apagar pra todos" só quem mandou
        allow update: if (ehAdministracao() && soMudou(['lida', 'deletadoParaAdmin']))
                      || (ehMoradorDono(moradorUid) && soMudou(['lida', 'deletadoParaMorador']))
                      || (ehAdministracao() && resource.data.deAdmin == true
                          && soMudou(['deletadoParaTodos', 'conteudo', 'tipo', 'imagemUrl']))
                      || (ehMoradorDono(moradorUid) && resource.data.deAdmin == false
                          && soMudou(['deletadoParaTodos', 'conteudo', 'tipo', 'imagemUrl']));
        allow delete: if ehAdministracao();
      }
    }

    // Chat admin: conversa privada entre dois administradores (conversasAdmin/{uidMenor_uidMaior}).
    // Só os dois participantes leem e escrevem; "resource == null" deixa ver se a conversa já existe.
    function participaChatAdmin(conversaId) {
      return ehAdmin() && request.auth.uid in get(caminho('conversasAdmin', conversaId)).data.participantes;
    }
    match /conversasAdmin/{conversaId} {
      allow read: if ehAdmin() && (resource == null || request.auth.uid in resource.data.participantes);
      allow create: if ehAdmin()
                    && request.auth.uid in request.resource.data.participantes
                    && request.resource.data.participantes.size() == 2;
      allow update: if ehAdmin()
                    && request.auth.uid in resource.data.participantes
                    && soMudou(['ultimaMensagem', 'ultimoTimestamp', 'ultimoRemetenteId', 'naoLidas1', 'naoLidas2']);
      allow delete: if ehAdmin() && request.auth.uid in resource.data.participantes;

      match /mensagens/{id} {
        allow read, delete: if participaChatAdmin(conversaId);
        allow create: if participaChatAdmin(conversaId)
                      && request.resource.data.remetenteId == request.auth.uid
                      && request.auth.uid != request.resource.data.destinatarioId
                      && request.resource.data.destinatarioId in get(caminho('conversasAdmin', conversaId)).data.participantes
                      && request.resource.data.timestamp == request.time;
        allow update: if participaChatAdmin(conversaId)
                      && (soMudou(['lida', 'deletadoParaRemetente', 'deletadoParaDestinatario'])
                          || (resource.data.remetenteId == request.auth.uid
                              && soMudou(['deletadoParaTodos', 'conteudo'])));
      }
    }

    // Backups: o servidor grava (Admin SDK); os admins só veem a lista.
    match /backups/{id} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    // Aparelho de cada conta pra notificação do chat (token do Firebase Messaging). Cada um só
    // grava o próprio; quem lê e envia é a Cloud Function notificarMensagemChat (Admin SDK).
    match /dispositivos/{uid} {
      allow read, delete: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid && membro()
                            && request.resource.data.keys().hasOnly(['token', 'app', 'administracao', 'atualizadoEm'])
                            && request.resource.data.token is string
                            // "administracao" (recebe as mensagens dos moradores) só pra admin ou conta master
                            && (request.resource.data.get('administracao', false) == false
                                || ehAdmin() || moradorVeTodos());
    }

    // Informações do condomínio: todos os membros leem, só admin grava
    match /avisos/{id} {
      allow read: if membro();
      allow write: if ehAdmin();
    }
    match /assembleias/{id} {
      allow read: if membro();
      allow write: if ehAdmin();
    }
    match /despesas/{id} {
      allow read: if membro();
      allow write: if ehAdmin();
    }

    // Gestão interna: só admin
    match /ocorrencias/{id} {
      allow read, write: if ehAdmin();
    }
    match /manutencoes/{id} {
      allow read, write: if ehAdmin();
    }
    match /funcionarios/{id} {
      allow read, write: if ehAdmin();
    }

    // Qualquer outra coleção fica fechada
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
