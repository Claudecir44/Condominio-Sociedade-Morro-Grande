rules_version = '2';

// Regras do app Condomínio Sociedade Morro Grande.
// - Administrador: conta no Firebase Auth + documento administradores/{uid} com tipo == 'admin'.
// - Morador: conta no Firebase Auth (login quadra+lote) + documento moradores/{uid}.
// - Morador só lê; quem grava é o administrador.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function caminho(colecao, id) {
      return /databases/$(database)/documents/$(colecao)/$(id);
    }

    function ehAdmin() {
      return logado()
          && exists(caminho('administradores', request.auth.uid))
          && get(caminho('administradores', request.auth.uid)).data.tipo == 'admin';
    }

    function ehMorador() {
      return logado() && exists(caminho('moradores', request.auth.uid));
    }

    function membro() {
      return ehAdmin() || ehMorador();
    }

    // Marca que o primeiro administrador já foi criado. Leitura pública só pra tela de login
    // saber se mostra o cadastro do primeiro admin (não tem dado pessoal).
    match /config/setup {
      allow read: if true;
      allow create: if logado()
                    && !exists(caminho('config', 'setup'))
                    && request.resource.data.primeiroAdmin == request.auth.uid
                    && getAfter(caminho('administradores', request.auth.uid)).data.tipo == 'admin';
      allow update, delete: if false;
    }

    match /administradores/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      // Novo admin: criado por um admin, ou o primeiro admin (junto com config/setup, uma vez só)
      allow create: if ehAdmin()
                    || (logado()
                        && request.auth.uid == uid
                        && request.resource.data.tipo == 'admin'
                        && !exists(caminho('config', 'setup'))
                        && existsAfter(caminho('config', 'setup')));
      allow update: if ehAdmin();
      allow delete: if ehAdmin() && request.auth.uid != uid;
    }

    // Pedido do "Cadastre-se" do login admin: a própria conta cria o pedido pendente;
    // só admin lê a lista, aprova (cria administradores/{uid} e apaga o pedido) ou recusa.
    match /solicitacoes_admin/{uid} {
      allow read: if ehAdmin() || (logado() && request.auth.uid == uid);
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pendente'
                    && !exists(caminho('administradores', uid));
      allow update, delete: if ehAdmin();
    }

    match /moradores/{uid} {
      allow read: if ehAdmin() || (logado() && request.auth.uid == uid);
      allow write: if ehAdmin();
    }

    // Informações do condomínio: todos os membros leem, só admin grava
    match /avisos/{id} {
      allow read: if membro();
      allow write: if ehAdmin();
    }
    match /assembleias/{id} {
      allow read: if membro();
      allow write: if ehAdmin();
    }
    match /despesas/{id} {
      allow read: if membro();
      allow write: if ehAdmin();
    }

    // Gestão interna: só admin
    match /ocorrencias/{id} {
      allow read, write: if ehAdmin();
    }
    match /manutencoes/{id} {
      allow read, write: if ehAdmin();
    }
    match /funcionarios/{id} {
      allow read, write: if ehAdmin();
    }

    // Qualquer outra coleção fica fechada
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
